"""Check a veneer pass (aros_veneers.py) against the object it rewrote.

    check-veneers BEFORE AFTER

BEFORE is the ld -r output of the AROS link, AFTER the same file once
range-extension islands were inserted into its .text. Independently of the
pass, the check derives every displacement from the symbol table, then
decodes each code word of BEFORE (the $x ranges) that the linker resolved
itself, without a relocation: B, BL, B.cond, CBZ/CBNZ, TBZ/TBNZ, LDR
(literal), ADR and ADRP. Such a reference stays right only if its site and
its target moved by the same amount, and only if AFTER holds the same word at
the moved site. Every island must begin with a branch over itself. Exit
status 0 and "result=PASS" when all of it holds.
"""
import bisect
import struct
import sys
from array import array

PAGE = 4096
SH = "<IIQQQQIIQQ"


def load(path):
    data = open(path, "rb").read()
    shoff, = struct.unpack_from("<Q", data, 0x28)
    shentsize, shnum, shstrndx = struct.unpack_from("<HHH", data, 0x3A)
    secs = [struct.unpack_from(SH, data, shoff + i * shentsize) for i in range(shnum)]
    names = secs[shstrndx]

    def name(s):
        o = names[4] + s[0]
        return data[o:data.index(b"\0", o)].decode()

    text = next(i for i, s in enumerate(secs) if name(s) == ".text")
    symi = next(i for i, s in enumerate(secs) if s[1] == 2)
    strs = secs[secs[symi][6]]
    syms = []
    for k in range(secs[symi][5] // 24):
        st_name, st_info, _, shndx, value, size = struct.unpack_from(
            "<IBBHQQ", data, secs[symi][4] + k * 24)
        o = strs[4] + st_name
        syms.append((data[o:data.index(b"\0", o)], st_info & 0xF, shndx, value, size))
    relocs = set()
    for s in secs:
        if s[1] == 4 and s[7] == text:
            for k in range(s[5] // 24):
                relocs.add(struct.unpack_from("<Q", data, s[4] + k * 24)[0])
    t = secs[text]
    return data[t[4]:t[4] + t[5]], text, syms, relocs


def sx(v, bits):
    return v - (1 << bits) if v & (1 << (bits - 1)) else v


def target(w, o):
    """The resolved PC-relative target of the word W at O, or None."""
    if w & 0x7C000000 == 0x14000000:                      # B, BL
        return o + sx(w & 0x3FFFFFF, 26) * 4, "b/bl"
    if w & 0xFF000010 == 0x54000000:                      # B.cond
        return o + sx((w >> 5) & 0x7FFFF, 19) * 4, "b.cond"
    if w & 0x7E000000 == 0x34000000:                      # CBZ, CBNZ
        return o + sx((w >> 5) & 0x7FFFF, 19) * 4, "cbz"
    if w & 0x7E000000 == 0x36000000:                      # TBZ, TBNZ
        return o + sx((w >> 5) & 0x3FFF, 14) * 4, "tbz"
    if w & 0x3B000000 == 0x18000000:                      # LDR (literal)
        return o + sx((w >> 5) & 0x7FFFF, 19) * 4, "ldr"
    if w & 0x9F000000 == 0x10000000:                      # ADR
        return o + sx(((w >> 5) & 0x7FFFF) << 2 | (w >> 29) & 3, 21), "adr"
    if w & 0x9F000000 == 0x90000000:                      # ADRP
        imm = sx(((w >> 5) & 0x7FFFF) << 2 | (w >> 29) & 3, 21)
        return (o & ~0xFFF) + imm * PAGE, "adrp"
    return None


def main(argv):
    if len(argv) != 3:
        print(__doc__.strip().splitlines()[2].strip())
        return 2
    old, old_ti, old_syms, old_relocs = load(argv[1])
    new, new_ti, new_syms, _ = load(argv[2])
    failures = []
    if len(old_syms) != len(new_syms):
        print("check-veneers: the symbol tables differ in length\nresult=FAIL")
        return 1

    # Displacement of every .text symbol; it must be a page multiple that
    # never decreases along .text.
    moves = []
    for a, b in zip(old_syms, new_syms):
        if a[0] != b[0] or a[2] != b[2]:
            print(f"check-veneers: symbol {a[0]!r} differs\nresult=FAIL")
            return 1
        if a[2] == old_ti and a[1] != 3:
            moves.append((a[3], b[3] - a[3], a[0], a[4]))
    moves.sort()
    starts = [m[0] for m in moves]
    shifts = [m[1] for m in moves]
    for (o1, s1, n1, _), (o2, s2, n2, _) in zip(moves, moves[1:]):
        if s2 < s1 or s2 % PAGE:
            failures.append(f"symbol {n2!r} at {o2:#x} moves by {s2}, after {n1!r} by {s1}")
    for o, s, n, size in moves:
        j = bisect.bisect_left(starts, o + 1)
        if size and j < len(moves) and starts[j] < o + size and shifts[j] != s:
            failures.append(f"symbol {n!r} [{o:#x}, +{size}) is split by an island")

    def shift(x):
        j = bisect.bisect_right(starts, x)
        return shifts[j - 1] if j else 0

    # Islands: each displacement step is one island, starting with a branch
    # over itself.
    islands = 0
    prev = 0
    for j, s in enumerate(shifts):
        if s != prev:
            size = s - prev
            isl = starts[j] + s - size
            w, = struct.unpack_from("<I", new, isl)
            if w != 0x14000000 | (size // 4):
                failures.append(f"island at {isl:#x} does not start with a branch over its {size} bytes")
            islands += 1
            prev = s

    # Code ranges from the mapping symbols.
    marks = sorted((a[3], a[0]) for a in old_syms
                   if a[2] == old_ti and a[0] in (b"$x", b"$d"))
    words = array("I")
    words.frombytes(old[:len(old) // 4 * 4])
    if sys.byteorder != "little":
        words.byteswap()
    checked = {}
    for k, (start, kind) in enumerate(marks):
        if kind != b"$x":
            continue
        end = marks[k + 1][0] if k + 1 < len(marks) else len(old)
        for o in range((start + 3) & ~3, end & ~3, 4):
            if o in old_relocs:
                continue
            w = words[o >> 2]
            r = target(w, o)
            if r is None:
                continue
            t, what = r
            checked[what] = checked.get(what, 0) + 1
            so, st = shift(o), shift(t)
            if so != st:
                failures.append(f"{what} at {o:#x} -> {t:#x}: site moves {so}, target {st}")
            elif new[o + so:o + so + 4] != old[o:o + 4]:
                failures.append(f"{what} at {o:#x}: word not copied to {o + so:#x}")
    total = sum(checked.values())
    print(f"check-veneers: {islands} islands, {len(moves)} symbols, "
          f"{total} resolved PC-relative words checked "
          f"({', '.join(f'{k} {v}' for k, v in sorted(checked.items()))})")
    for f in failures[:20]:
        print("check-veneers: " + f)
    if len(failures) > 20:
        print(f"check-veneers: ... {len(failures) - 20} more")
    print("result=" + ("FAIL" if failures or not islands else "PASS"))
    return 1 if failures or not islands else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
