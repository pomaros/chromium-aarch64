# Dawn for AArch64 AROS, Vulkan backend only. Paths are explicit generator inputs.
target_os = "aros"
target_cpu = "arm64"
is_debug = false
is_component_build = false
is_official_build = false
symbol_level = 1
treat_warnings_as_errors = false
use_custom_libcxx = false
use_sysroot = false
use_lld = false
use_gold = false
is_cfi = false
use_thin_lto = false
clang_use_chrome_plugins = false
dawn_enable_vulkan = true
dawn_enable_vulkan_loader = false
dawn_enable_vulkan_validation_layers = false
dawn_enable_null = true
dawn_enable_desktop_gl = false
dawn_enable_opengles = false
dawn_enable_d3d11 = false
dawn_enable_d3d12 = false
dawn_enable_metal = false
dawn_use_swiftshader = false
dawn_use_x11 = false
dawn_use_wayland = false
dawn_enable_spirv_validation = false
tint_build_spv_reader = true
tint_build_spv_writer = true
tint_build_wgsl_reader = true
tint_build_wgsl_writer = true
tint_build_msl_writer = true
tint_build_hlsl_writer = true
tint_build_glsl_writer = true
tint_build_glsl_validator = false
dawn_tests_use_angle = false
