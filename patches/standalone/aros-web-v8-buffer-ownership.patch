From 9400010d4d492aeb752c45d90be6ceccdaa770e7 Mon Sep 17 00:00:00 2001
From: John KNIPPER <code@jkn.me>
Date: Sat, 24 Oct 2026 14:24:39 +0200
Subject: [PATCH] v8.library: expose paired resident byte buffer ownership API

---
 libs/v8/include/v8.h       | 15 ++++++++++++++-
 libs/v8/mmakefile.src      |  2 ++
 libs/v8/v8.conf            |  4 +++-
 libs/v8/v8_allocator.cpp   | 13 +++++++++++++
 libs/v8/v8_allocator.h     |  8 ++++++++
 libs/v8/v8allocatebuffer.c | 22 ++++++++++++++++++++++
 libs/v8/v8freebuffer.c     | 22 ++++++++++++++++++++++
 7 files changed, 84 insertions(+), 2 deletions(-)
 create mode 100644 libs/v8/v8allocatebuffer.c
 create mode 100644 libs/v8/v8freebuffer.c

diff --git a/libs/v8/include/v8.h b/libs/v8/include/v8.h
index 2f570cc..2c9789e 100644
--- a/libs/v8/include/v8.h
+++ b/libs/v8/include/v8.h
@@ -63,11 +63,24 @@ typedef APTR V8ObjectHandle;   /* Handle to V8 object */
 
 /****************************************************************************/
 
+/* V8AllocateBuffer(size) / V8FreeBuffer(ptr), available since version 1.3:
+ * allocate a byte array using v8.library's own operator new[] and release it
+ * using its operator delete[]. Zero size requests allocate one byte; NULL
+ * reports allocation failure. Freeing NULL is harmless.
+ *
+ * Before handing a buffer to an owning V8 API (ExternalSourceStream chunks
+ * or CachedData::BufferOwned), the caller owns it and must use V8FreeBuffer
+ * on cancellation or failure. Successful transfer gives V8 ownership; the
+ * caller must then neither free nor access the buffer. Do not use a caller's
+ * delete[], free(), or stdc.library base for these buffers. Keep the resident
+ * library open until all buffers and owning V8 objects are released.
+ */
+
 /* V8_LIBRARY_INTERFACE
  * AROS_IMPL: Follows standard AROS library conventions, compatible with exec.library
  * REFERENCE: https://v8.dev/docs/embed - V8 embedder's guide
  * DESIGN: Single isolate per library user, multiple contexts supported
- * MEMORY: Uses exec.library AllocVec/FreeVec for memory management
+ * MEMORY: Owning V8 byte-array APIs require resident-allocated buffers.
  * THREAD_SAFETY: Each isolate is single-threaded, multiple isolates can run concurrently
  */
 
diff --git a/libs/v8/mmakefile.src b/libs/v8/mmakefile.src
index 24606d6..4b8cac0 100644
--- a/libs/v8/mmakefile.src
+++ b/libs/v8/mmakefile.src
@@ -105,6 +105,8 @@ endif
 
 # List of all implementation files
 FUNCS := v8allocatorinstall \
+    v8allocatebuffer \
+    v8freebuffer \
     v8allocatorisinstalled \
     v8ownerrangeadd \
     v8ownerrangeremove \
diff --git a/libs/v8/v8.conf b/libs/v8/v8.conf
index 8d3f14e..9a84d7d 100644
--- a/libs/v8/v8.conf
+++ b/libs/v8/v8.conf
@@ -1,7 +1,7 @@
 ##begin config
 basename V8
 libbasetype struct V8Base
-version 1.2
+version 1.3
 seglist_field v8_SegList
 residentpri -120
 options noexpunge
@@ -38,4 +38,6 @@ BOOL V8OwnerRangeAdd(APTR base, IPTR size, APTR freeFn) (A0, D0, A1)
 BOOL V8OwnerRangeRemove(APTR base) (A0)
 BOOL V8OwnerCheckAdd(APTR ownsFn, APTR freeFn) (A0, A1)
 BOOL V8OwnerCheckRemove(APTR ownsFn) (A0)
+APTR V8AllocateBuffer(IPTR size) (D0)
+void V8FreeBuffer(APTR ptr) (A0)
 ##end functionlist
diff --git a/libs/v8/v8_allocator.cpp b/libs/v8/v8_allocator.cpp
index 30d82dc..ff06aaf 100644
--- a/libs/v8/v8_allocator.cpp
+++ b/libs/v8/v8_allocator.cpp
@@ -419,3 +419,16 @@ void operator delete[](void *ptr, const std::nothrow_t &) noexcept { V8HeapRelea
    so omitting them would leave most of V8's deallocations on libstdc++. */
 void operator delete(void *ptr, size_t) noexcept           { V8HeapRelease(ptr); }
 void operator delete[](void *ptr, size_t) noexcept         { V8HeapRelease(ptr); }
+
+/* Keep these operations in the resident module: stdc.library has a separate
+ * heap for each opener, so allocation through a consumer's stdc base is not
+ * interchangeable with this library's delete[]. */
+extern "C" APTR V8AllocateBufferImpl(IPTR size)
+{
+    return new unsigned char[size ? size : 1];
+}
+
+extern "C" void V8FreeBufferImpl(APTR ptr)
+{
+    delete[] static_cast<unsigned char *>(ptr);
+}
diff --git a/libs/v8/v8_allocator.h b/libs/v8/v8_allocator.h
index 51d55e2..52a079a 100644
--- a/libs/v8/v8_allocator.h
+++ b/libs/v8/v8_allocator.h
@@ -52,6 +52,14 @@ BOOL V8OwnerRangeRemoveImpl(APTR base);
 BOOL V8OwnerCheckAddImpl(V8OwnsFunc ownsFn, V8FreeFunc freeFn);
 BOOL V8OwnerCheckRemoveImpl(V8OwnsFunc ownsFn);
 
+/* Buffers transferred to V8's owning byte-array APIs must be allocated by
+ * the resident's operator new[]. Before transfer, release them only through
+ * the paired free entry point; after transfer V8 performs delete[] itself.
+ * A zero-size request still allocates one byte. NULL means allocation failed.
+ */
+APTR V8AllocateBufferImpl(IPTR size);
+void V8FreeBufferImpl(APTR ptr);
+
 #ifdef __cplusplus
 }
 #endif
diff --git a/libs/v8/v8allocatebuffer.c b/libs/v8/v8allocatebuffer.c
new file mode 100644
index 0000000..1633459
--- /dev/null
+++ b/libs/v8/v8allocatebuffer.c
@@ -0,0 +1,22 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+    Copyright (C) 2026, John Knipper.
+
+    Desc: Allocate a buffer in the resident V8 byte-array allocation domain.
+*/
+
+#include <aros/libcall.h>
+#include "v8_intern.h"
+#include "v8_allocator.h"
+
+AROS_LH1(APTR, V8AllocateBuffer,
+    AROS_LHA(IPTR, size, D0),
+    struct V8Base *, V8Base, 26, V8)
+{
+    AROS_LIBFUNC_INIT
+
+    (void)V8Base;
+    return V8AllocateBufferImpl(size);
+
+    AROS_LIBFUNC_EXIT
+}
diff --git a/libs/v8/v8freebuffer.c b/libs/v8/v8freebuffer.c
new file mode 100644
index 0000000..06df6a3
--- /dev/null
+++ b/libs/v8/v8freebuffer.c
@@ -0,0 +1,22 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+    Copyright (C) 2026, John Knipper.
+
+    Desc: Release a V8 buffer before its ownership has been transferred.
+*/
+
+#include <aros/libcall.h>
+#include "v8_intern.h"
+#include "v8_allocator.h"
+
+AROS_LH1(void, V8FreeBuffer,
+    AROS_LHA(APTR, ptr, A0),
+    struct V8Base *, V8Base, 27, V8)
+{
+    AROS_LIBFUNC_INIT
+
+    (void)V8Base;
+    V8FreeBufferImpl(ptr);
+
+    AROS_LIBFUNC_EXIT
+}
