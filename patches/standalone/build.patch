diff --git a/toolchain/aros/BUILD.gn b/toolchain/aros/BUILD.gn
new file mode 100644
index 0000000..407fa8d
--- /dev/null
+++ b/toolchain/aros/BUILD.gn
@@ -0,0 +1,90 @@
+# Copyright 2026 The Chromium Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+import("//build/toolchain/gcc_toolchain.gni")
+
+declare_args() {
+  # GCC port: directory holding the x86_64-aros-* binaries.
+  aros_toolchain_root = ""
+
+  # Clang port: directory holding clang, clang++, llvm-ar, llvm-nm, llvm-readelf.
+  # The clang driver knows the aarch64-unknown-aros target (startup objects,
+  # the AROS link group, libc++ from the toolchain tree).
+  aros_clang_root = ""
+
+  # AROS SDK root, the directory containing include/ and lib/ (an AROS build's
+  # bin/<arch>/AROS/Developer). Passed as --sysroot.
+  aros_sysroot = ""
+
+  # Directory holding the AROS link driver `collect-aros`; passed as -B so the
+  # clang driver can execute it.
+  aros_tool_dir = ""
+}
+
+_sysroot_flag = ""
+if (aros_sysroot != "") {
+  _sysroot_flag = " --sysroot=$aros_sysroot"
+}
+
+if (target_cpu == "x64") {
+  assert(aros_toolchain_root != "",
+         "Set aros_toolchain_root to the AROS cross-toolchain directory.")
+}
+if (target_cpu == "arm64") {
+  assert(aros_clang_root != "",
+         "Set aros_clang_root to the directory holding the AROS clang.")
+  assert(aros_tool_dir != "",
+         "Set aros_tool_dir to the directory holding collect-aros.")
+}
+
+_toolprefix = "$aros_toolchain_root/x86_64-aros-"
+
+gcc_toolchain("x64") {
+  cc = "${_toolprefix}gcc"
+  cxx = "${_toolprefix}g++"
+  ar = "${_toolprefix}ar"
+  ld = cxx
+  readelf = "${_toolprefix}readelf"
+  nm = "${_toolprefix}nm"
+
+  extra_cppflags =
+      "-m64 -mcmodel=large -mno-red-zone -mno-ms-bitfields" +
+      " -fno-asynchronous-unwind-tables -fno-omit-frame-pointer" + _sysroot_flag
+  extra_ldflags = "-m64 -mcmodel=large" + _sysroot_flag
+
+  toolchain_args = {
+    current_cpu = "x64"
+    current_os = "aros"
+    is_clang = false
+    use_remoteexec = false
+    use_goma = false
+    use_sysroot = false
+  }
+}
+
+# AArch64 AROS is built with the LLVM toolchain the AROS tree itself uses:
+# clang with --target=aarch64-unknown-aros, the large code model, no PIC/PIE
+# (AROS executables are relocatable ELF objects, not shared objects), linked
+# through collect-aros.
+gcc_toolchain("arm64") {
+  cc = "$aros_clang_root/clang"
+  cxx = "$aros_clang_root/clang++"
+  ar = "$aros_clang_root/llvm-ar"
+  ld = cxx
+  readelf = "$aros_clang_root/llvm-readelf"
+  nm = "$aros_clang_root/llvm-nm"
+
+  _target_flags = "--target=aarch64-unknown-aros -mcmodel=large -fno-pic -fno-pie"
+  extra_cppflags = _target_flags + " -fno-omit-frame-pointer" + _sysroot_flag
+  extra_ldflags = _target_flags + " -B$aros_tool_dir" + _sysroot_flag
+
+  toolchain_args = {
+    current_cpu = "arm64"
+    current_os = "aros"
+    is_clang = true
+    use_remoteexec = false
+    use_goma = false
+    use_sysroot = false
+  }
+}
