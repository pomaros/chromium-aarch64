From: John Knipper <code@jkn.me>
Subject: [PATCH] aros: reserve PartitionAlloc pages without memory

Reserve every range with MEMF_RESERVE (core 118b4b2f7b): KrnSetProtection
commits what it makes accessible, cleared, and gives back what it makes
inaccessible. Decommit is then a protection change that returns memory, and
recommit returns zeroed pages without a memset. The regular pool takes its
whole cap instead of a share of free RAM. A kernel that ignored MEMF_RESERVE
would keep stale contents across a decommit, so the first allocation checks
that a reservation has nothing behind it.

--- a/base/allocator/partition_allocator/src/partition_alloc/page_allocator_internals_aros.h
+++ b/base/allocator/partition_allocator/src/partition_alloc/page_allocator_internals_aros.h
@@ -30,6 +30,12 @@
 
 extern "C" void ArosKPutStr(const char*) asm("KPutStr");
 
+// Address space without memory: KrnSetProtection commits what it makes
+// accessible (cleared) and gives back what it makes inaccessible.
+#ifndef MEMF_RESERVE
+#define MEMF_RESERVE (1L << 14)
+#endif
+
 namespace partition_alloc::internal {
 
 // KrnAllocPages treats a non-null address as an exact native mapping request.
@@ -103,6 +109,24 @@
   return nullptr;
 }
 
+// A kernel that ignores MEMF_RESERVE backs the pages at once: a decommit
+// would then keep their contents and a recommit would not return zeros.
+// Check once that a reservation has nothing behind it.
+void CheckReservationSupport(APTR KernelBase) {
+  (void)KernelBase;  // Used by the native kernel vector call macros.
+  static std::atomic<int> checked{0};
+  if (checked.load(std::memory_order_acquire)) {
+    return;
+  }
+  void* probe = KrnAllocPages(nullptr, PageAllocationGranularity(),
+                              MEMF_PUBLIC | MEMF_RESERVE);
+  PA_CHECK(probe);
+  const bool lazy = KrnVirtualToPhysical(probe) == nullptr;
+  KrnFreePages(probe, PageAllocationGranularity());
+  PA_CHECK(lazy);
+  checked.store(1, std::memory_order_release);
+}
+
 KRN_PageProtect GetPageProtector(APTR KernelBase) {
   (void)KernelBase;  // Used by the native kernel vector call macros.
   const intptr_t operation = KrnGetSystemAttr(KATTR_PageProtect);
@@ -207,7 +231,10 @@
     return 0;
   }
 
-  ULONG flags = MEMF_PUBLIC | MEMF_CLEAR;
+  CheckReservationSupport(KernelBase);
+  // Reserved, not backed: the protection set below commits what is
+  // accessible, cleared.
+  ULONG flags = MEMF_PUBLIC | MEMF_RESERVE;
