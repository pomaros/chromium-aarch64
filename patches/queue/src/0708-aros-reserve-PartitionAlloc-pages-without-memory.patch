   if (accessibility.permissions ==
           PageAccessibilityConfiguration::kInaccessibleWillJitLater ||
@@ -381,18 +408,11 @@
   APTR KernelBase = OpenKernelResource();
   PA_CHECK(KernelBase);
   const auto protect = GetPageProtector(KernelBase);
+  // Every range is a reservation: removing access gives its pages back, and
+  // they come back cleared when access is granted again.
   pthread_mutex_lock(&s_pageAllocationLock);
-  const bool writable = FindPageAllocation(address, length) &&
-      SetProtection(protect, address, length,
-                    static_cast<KRN_MapAttr>(MAP_Readable | MAP_Writable));
-  if (!writable) {
-    pthread_mutex_unlock(&s_pageAllocationLock);
-    PA_CHECK(writable);
-    return;
-  }
-  std::memset(reinterpret_cast<void*>(address), 0, length);
-  const bool inaccessible = SetProtection(protect, address, length,
-                                          static_cast<KRN_MapAttr>(0));
+  const bool inaccessible = FindPageAllocation(address, length) &&
+      SetProtection(protect, address, length, static_cast<KRN_MapAttr>(0));
   pthread_mutex_unlock(&s_pageAllocationLock);
   PA_CHECK(inaccessible);
   TracePageEvent("decommit", address, length, 0);
@@ -416,17 +436,10 @@
   if (!protect) {
     return false;
   }
+  // Pages given back by a decommit are committed again, cleared.
   pthread_mutex_lock(&s_pageAllocationLock);
-  const bool writable = FindPageAllocation(address, length) &&
-      SetProtection(protect, address, length,
-                    static_cast<KRN_MapAttr>(MAP_Readable | MAP_Writable));
-  if (!writable) {
-    pthread_mutex_unlock(&s_pageAllocationLock);
-    return false;
-  }
-  std::memset(reinterpret_cast<void*>(address), 0, length);
-  const bool accessible = SetProtection(protect, address, length,
-                                        GetAccessFlags(accessibility));
+  const bool accessible = FindPageAllocation(address, length) &&
+      SetProtection(protect, address, length, GetAccessFlags(accessibility));
   pthread_mutex_unlock(&s_pageAllocationLock);
   return accessible;
 }
@@ -441,8 +454,8 @@
 }
 
 void DiscardSystemPagesInternal(uintptr_t, size_t) {
-  // The current native window eagerly backs its mappings. Discard is a hint;
-  // decommit retains ownership, zeroes memory and removes access instead.
+  // A hint. Discarded pages stay accessible, and the kernel cannot give an
+  // accessible page back; decommit is what returns memory.
 }
 
 }  // namespace partition_alloc::internal
