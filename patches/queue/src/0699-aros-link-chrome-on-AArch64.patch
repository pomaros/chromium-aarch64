From ab7d10c0abd35ede8d6c418da4e97ee81addf500 Mon Sep 17 00:00:00 2001
From: John KNIPPER <code@jkn.me>
Date: Fri, 23 Oct 2026 18:11:43 +0200
Subject: [PATCH] aros: link chrome on AArch64

- v8.library imports: the AArch64 toolchain is clang with libc++, so the
  17 engine API names that carry standard-library types mangle as
  NSt3__1... instead of libstdc++'s St...; v8_function_imports_libcxx.txt
  holds them, matched to the arm64 monolith by demangled signature.
- chrome: the close() trace wraps __posixc_open/__posixc_close, which only
  the x86-64 development SDK exports under those names; keep it on x64.
  The pthread_create wrap (codec thread placement) stays everywhere.
- cpuinfo: build the AArch64 AROS backend (third_party/cpuinfo/src 0001).
---
 build/config/aros/v8_library/BUILD.gn         |  12 +-
 .../v8_library/v8_function_imports_libcxx.txt | 712 ++++++++++++++++++
 chrome/BUILD.gn                               |  18 +-
 third_party/cpuinfo/BUILD.gn                  |  10 +
 4 files changed, 745 insertions(+), 7 deletions(-)
 create mode 100644 build/config/aros/v8_library/v8_function_imports_libcxx.txt

diff --git a/build/config/aros/v8_library/BUILD.gn b/build/config/aros/v8_library/BUILD.gn
index 6c12d93031..972df56fe3 100644
--- a/build/config/aros/v8_library/BUILD.gn
+++ b/build/config/aros/v8_library/BUILD.gn
@@ -6,11 +6,21 @@ assert(is_aros)
 
 _generated_imports = "$target_gen_dir/v8_library_imports.S"
 
+# The engine's exported C++ API, by mangled name. The x64 toolchain is GCC with
+# libstdc++ (std::unique_ptr mangles as St10unique_ptr); the AArch64 toolchain
+# is clang with libc++ (NSt3__110unique_ptr), so the names that carry standard
+# library types differ.
+if (current_cpu == "arm64") {
+  _imports_manifest = "v8_function_imports_libcxx.txt"
+} else {
+  _imports_manifest = "v8_function_imports.txt"
+}
+
 action("generate_v8_library_imports") {
   script = "generate_v8_imports.py"
 
   inputs = [
-    "v8_function_imports.txt",
+    _imports_manifest,
     "../import_trampolines_arm64.py",
   ]
   outputs = [ _generated_imports ]
