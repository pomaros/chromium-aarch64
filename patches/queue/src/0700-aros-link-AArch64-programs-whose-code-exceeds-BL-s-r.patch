 build/toolchain/aros/aros_link.py         |  40 +++
 build/toolchain/aros/aros_veneers.py      | 293 ++++++++++++++++++++++
 4 files changed, 342 insertions(+), 3 deletions(-)
 create mode 100644 build/toolchain/aros/aros_link.py
 create mode 100644 build/toolchain/aros/aros_veneers.py

