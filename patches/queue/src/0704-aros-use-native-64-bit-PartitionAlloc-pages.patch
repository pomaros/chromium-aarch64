From: John Knipper <code@jkn.me>
Subject: [PATCH] aros: use native 64-bit PartitionAlloc pages

Infer pointer width from the actual CPU. Use native kernel mappings and
checked protection, release real alignment slack and track exact ownership.
Bound eagerly backed pools by available memory rather than physical block
contiguity. Concurrent first use additionally requires serialized native
pthread mutex initialization; this patch does not implement demand paging.

diff --git a/base/allocator/partition_allocator/partition_alloc.gni b/base/allocator/partition_allocator/partition_alloc.gni
--- a/base/allocator/partition_allocator/partition_alloc.gni
+++ b/base/allocator/partition_allocator/partition_alloc.gni
@@ -19,11 +19,6 @@
 # A static_assert in partition_alloc_config.h verifies that.
 if (is_nacl) {
   # NaCl targets don't use 64-bit pointers.
-  has_64_bit_pointers = false
-} else if (is_aros) {
-  # AROS has no reserve-without-commit: a size-aligned pool is a physically
-  # backed block of twice its size. Take the configuration that reserves
-  # super pages one at a time, on demand, and tracks them in a bitmap.
   has_64_bit_pointers = false
 } else if (current_cpu == "x64" || current_cpu == "arm64" ||
            current_cpu == "loong64" || current_cpu == "riscv64") {
diff --git a/base/allocator/partition_allocator/src/partition_alloc/partition_alloc_config.h b/base/allocator/partition_allocator/src/partition_alloc/partition_alloc_config.h
--- a/base/allocator/partition_allocator/src/partition_alloc/partition_alloc_config.h
+++ b/base/allocator/partition_allocator/src/partition_alloc/partition_alloc_config.h
@@ -32,7 +32,7 @@
 // configurations.
 #if BUILDFLAG(HAS_64_BIT_POINTERS)
 static_assert(sizeof(void*) == 8, "");
-#elif !BUILDFLAG(IS_AROS)
+#else
 static_assert(sizeof(void*) != 8, "");
 #endif  // PA_CONFIG(HAS_64_BITS_POINTERS)

