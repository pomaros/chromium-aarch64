-void SetProtection(APTR KernelBase,
+struct PageAllocationRecord {
+  PageAllocationRecord* next;
+  uintptr_t base;
+  size_t length;
+};
+
+// Ownership belongs to native kernel mappings. Exec allocates only these small
+// metadata records, never backing or alignment slack for a page reservation.
+pthread_mutex_t s_pageAllocationLock = PTHREAD_MUTEX_INITIALIZER;
+PageAllocationRecord* s_pageAllocations = nullptr;
+
+bool ValidPageRange(uintptr_t address, size_t length) {
+  const size_t mask = PageAllocationGranularity() - 1;
+  return length && !(address & mask) && !(length & mask) &&
+         address <= std::numeric_limits<uintptr_t>::max() - length;
+}
+
+PageAllocationRecord* NewPageAllocationRecord() {
+  return static_cast<PageAllocationRecord*>(
+      AllocMem(sizeof(PageAllocationRecord), MEMF_PUBLIC | MEMF_CLEAR));
+}
+
+// The caller holds the mutex. Separate records must not be crossed by one
+// release/protection request, even when adjacent virtual addresses happen to fit.
+PageAllocationRecord** FindPageAllocation(uintptr_t address, size_t length) {
+  if (!ValidPageRange(address, length)) {
+    return nullptr;
+  }
+  for (auto** link = &s_pageAllocations; *link; link = &(*link)->next) {
+    const auto* record = *link;
+    if (address >= record->base) {
+      const size_t offset = address - record->base;
+      if (offset < record->length && length <= record->length - offset) {
+        return link;
+      }
+    }
+  }
+  return nullptr;
+}
+
+KRN_PageProtect GetPageProtector(APTR KernelBase) {
+  (void)KernelBase;  // Used by the native kernel vector call macros.
+  const intptr_t operation = KrnGetSystemAttr(KATTR_PageProtect);
+  if (!operation || operation == -1) {
+    return nullptr;
+  }
+  return reinterpret_cast<KRN_PageProtect>(operation);
+}
+
+bool SetProtection(KRN_PageProtect protect,
                    uintptr_t address,
                    size_t length,
                    KRN_MapAttr flags) {
-  constexpr size_t kMaxChunk =
-      static_cast<size_t>(std::numeric_limits<uint32_t>::max()) & ~size_t{4095};
-
+  if (!protect || !ValidPageRange(address, length)) {
+    return false;
+  }
+  const size_t max_chunk =
+      static_cast<size_t>(std::numeric_limits<uint32_t>::max()) &
+      ~(PageAllocationGranularity() - 1);
   while (length) {
-    const size_t chunk = std::min(length, kMaxChunk);
-    KrnSetProtection(reinterpret_cast<void*>(address),
-                     static_cast<uint32_t>(chunk), flags);
+    const size_t chunk = std::min(length, max_chunk);
+    if (!protect(reinterpret_cast<void*>(address),
+                 static_cast<uint32_t>(chunk), flags)) {
+      // The checked native operation may have converted a prefix. It does not
+      // provide an atomic rollback for a multi-page protection change.
+      return false;
+    }
     address += chunk;
     length -= chunk;
   }
