diff --git a/build/config/aros/import_trampolines_arm64.py b/build/config/aros/import_trampolines_arm64.py
new file mode 100644
index 0000000000..279078069a
--- /dev/null
+++ b/build/config/aros/import_trampolines_arm64.py
@@ -0,0 +1,148 @@
+# Copyright 2026 The Chromium Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+"""AArch64 AROS import trampolines for the shared engine libraries.
+
+Each import starts as a branch through a writable slot that initially points
+at the import's slow entry. The slow path preserves every AAPCS64 argument
+register (x0-x7, the indirect-result register x8, and q0-q7), asks the
+resolver for the target, caches it in the slot and tail-branches to it, so the
+first call behaves exactly like later ones. Addresses are materialised with
+the large-model MOVZ/MOVK relocations: the AROS loader places code and data
+hunks independently, so no PC-relative reach is assumed between them.
+"""
+
+
+def _absolute(register: str, symbol: str) -> list[str]:
+    return [
+        f"        movz {register}, #:abs_g3:{symbol}",
+        f"        movk {register}, #:abs_g2_nc:{symbol}",
+        f"        movk {register}, #:abs_g1_nc:{symbol}",
+        f"        movk {register}, #:abs_g0_nc:{symbol}",
+    ]
+
+
+def emit(
+    *,
+    generator: str,
+    symbols: list[str],
+    slow_path: str,
+    resolver: str,
+    slots: str,
+    count: str,
+    names: str,
+    data_imports: tuple[tuple[str, str], ...] = (),
+) -> str:
+    if len(symbols) > 0xFFFF:
+        raise ValueError("more imports than a MOVZ index can encode")
+
+    lines = [
+        f"// Generated by {generator}. Do not edit.",
+        "",
+        "        .text",
+        "        .p2align 4",
+        f"        .globl {slow_path}",
+        f"        .type {slow_path}, @function",
+        f"{slow_path}:",
+        "        // x17 holds the import index (set by the slow entry).",
+        "        stp x29, x30, [sp, #-224]!",
+        "        mov x29, sp",
+        "        stp x0, x1, [sp, #16]",
+        "        stp x2, x3, [sp, #32]",
+        "        stp x4, x5, [sp, #48]",
+        "        stp x6, x7, [sp, #64]",
+        "        str x8, [sp, #80]",
+        "        stp q0, q1, [sp, #96]",
+        "        stp q2, q3, [sp, #128]",
+        "        stp q4, q5, [sp, #160]",
+        "        stp q6, q7, [sp, #192]",
+        "        mov x0, x17",
+        f"        bl {resolver}",
+        "        mov x16, x0",
+        "        ldp q6, q7, [sp, #192]",
+        "        ldp q4, q5, [sp, #160]",
+        "        ldp q2, q3, [sp, #128]",
+        "        ldp q0, q1, [sp, #96]",
+        "        ldr x8, [sp, #80]",
+        "        ldp x6, x7, [sp, #64]",
+        "        ldp x4, x5, [sp, #48]",
+        "        ldp x2, x3, [sp, #32]",
+        "        ldp x0, x1, [sp, #16]",
+        "        ldp x29, x30, [sp], #224",
+        "        br x16",
+        f"        .size {slow_path}, .-{slow_path}",
+        "",
+    ]
+
+    for index, symbol in enumerate(symbols):
+        lines.extend(
+            [
+                "        .p2align 4",
+                f"        .globl {symbol}",
+                f"        .type {symbol}, @function",
+                f"{symbol}:",
+                *_absolute("x16", f"{slots}+{index * 8}"),
+                "        ldr x16, [x16]",
+                "        br x16",
+                f"        .size {symbol}, .-{symbol}",
+                f".Lslow_{index}:",
+                f"        movz x17, #{index}",
+                f"        b {slow_path}",
+                "",
+            ]
+        )
+
+    lines.extend(
+        [
+            "        .section .rodata",
+            "        .p2align 3",
+            f"        .globl {count}",
+            f"        .type {count}, @object",
+            f"{count}:",
+            f"        .quad {len(symbols)}",
+            f"        .size {count}, 8",
+            "",
+            f"        .globl {names}",
+            f"        .type {names}, @object",
+            f"{names}:",
+        ]
+    )
+    for index in range(len(symbols)):
+        lines.append(f"        .quad .Limport_name_{index}")
+    lines.append(f"        .size {names}, {len(symbols) * 8}")
+    lines.append("")
+    for index, symbol in enumerate(symbols):
+        lines.extend([f".Limport_name_{index}:", f'        .asciz "{symbol}"'])
+    for index, (_, value) in enumerate(data_imports):
+        lines.extend([f".Ldata_value_{index}:", f'        .asciz "{value}"'])
+
+    lines.extend(
+        [
+            "",
+            "        .data",
+            "        .p2align 3",
+            f"        .globl {slots}",
+            f"        .type {slots}, @object",
+            f"{slots}:",
+        ]
+    )
+    for index in range(len(symbols)):
+        lines.append(f"        .quad .Lslow_{index}")
+    lines.append(f"        .size {slots}, {len(symbols) * 8}")
+
+    for index, (symbol, _) in enumerate(data_imports):
+        lines.extend(
+            [
+                "",
+                "        .p2align 3",
+                f"        .globl {symbol}",
+                f"        .type {symbol}, @object",
+                f"{symbol}:",
+                f"        .quad .Ldata_value_{index}",
+                f"        .size {symbol}, 8",
+            ]
+        )
+
+    lines.extend(["", '        .section .note.GNU-stack,"",@progbits', ""])
+    return "\n".join(lines)
