From a1dda7e3c4c5e12e63f934bf810b23d9a4631080 Mon Sep 17 00:00:00 2001
From: John KNIPPER <code@jkn.me>
Date: Fri, 23 Oct 2026 04:02:48 +0200
Subject: [PATCH 694/696] partition_alloc: reach stdc.library vectors on
 AArch64 AROS

The allocator shim jumps into stdc.library's genmodule stack-call thunks
with the library base where those thunks expect it. That is %r11 on x86-64
and x16 on AArch64 (AROS_GM_LIBFUNCSTUB in
arch/aarch64-all/include/aros/genmodule.h). Add the AArch64 stub: load the
latched base through a large-model MOVZ/MOVK address, then branch through
base[-LVO] with x0-x7 untouched. Other architectures stop at compile time
instead of assembling x86-64 into them. x64 is unchanged.

Tested: a probe built with the same stub reaches malloc, calloc, realloc,
aligned_alloc and free through stdc.library's vectors for 1000 rounds on
AArch64 AROS in QEMU (calloc zeroed, realloc keeps the contents,
aligned_alloc aligns), and stub memory and ordinary malloc memory are freed
crosswise.
---
 .../shim/allocator_shim_aros_libc.cc          | 24 +++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/base/allocator/partition_allocator/src/partition_alloc/shim/allocator_shim_aros_libc.cc b/base/allocator/partition_allocator/src/partition_alloc/shim/allocator_shim_aros_libc.cc
index 94c76486f4..b1b89c2541 100644
--- a/base/allocator/partition_allocator/src/partition_alloc/shim/allocator_shim_aros_libc.cc
+++ b/base/allocator/partition_allocator/src/partition_alloc/shim/allocator_shim_aros_libc.cc
@@ -110,6 +110,7 @@ std::atomic<void**> aros_stdc_shim_base{nullptr};
 
 #define AROS_STDC_STRINGIZE_(x) #x
 #define AROS_STDC_STRINGIZE(x) AROS_STDC_STRINGIZE_(x)
+#if defined(__x86_64__)
 #define AROS_STDC_LVO_STUB(name, lvo)                              \
   asm(".text\n"                                                    \
       "\t.type " #name ", @function\n"                             \
@@ -117,6 +118,29 @@ std::atomic<void**> aros_stdc_shim_base{nullptr};
       "\tmovq aros_stdc_shim_base(%rip), %r11\n"                   \
       "\tjmp *-(" AROS_STDC_STRINGIZE(lvo) "*8)(%r11)\n"           \
       "\t.size " #name ", .-" #name "\n");
+#elif defined(__aarch64__)
+// AArch64 genmodule thunks take the base in x16 (AROS_GM_LIBFUNCSTUB in
+// arch/aarch64-all/include/aros/genmodule.h). The base's address is built
+// with the large-model MOVZ/MOVK relocations: code and data hunks are placed
+// independently.
+#define AROS_STDC_LVO_STUB(name, lvo)                              \
+  asm(".text\n"                                                    \
+      "\t.p2align 2\n"                                             \
+      "\t.type " #name ", @function\n"                             \
+      #name ":\n"                                                  \
+      "\tmovz x16, #:abs_g3:aros_stdc_shim_base\n"                 \
+      "\tmovk x16, #:abs_g2_nc:aros_stdc_shim_base\n"              \
+      "\tmovk x16, #:abs_g1_nc:aros_stdc_shim_base\n"              \
+      "\tmovk x16, #:abs_g0_nc:aros_stdc_shim_base\n"              \
+      "\tldr x16, [x16]\n"                                         \
+      "\tmov x17, #(" AROS_STDC_STRINGIZE(lvo) "*8)\n"             \
+      "\tsub x17, x16, x17\n"                                      \
+      "\tldr x17, [x17]\n"                                         \
+      "\tbr x17\n"                                                 \
+      "\t.size " #name ", .-" #name "\n");
+#else
+#error "AROS stdc.library vector stubs: unsupported architecture"
+#endif
 
 extern "C" {
 void aros_stdc_shim_free(void* ptr);
-- 
