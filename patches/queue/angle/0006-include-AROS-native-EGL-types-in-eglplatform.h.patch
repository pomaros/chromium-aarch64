From d5649f17c12da3cef0efdbed562142aaabe784cc Mon Sep 17 00:00:00 2001
From: John KNIPPER <code@jkn.me>
Date: Fri, 23 Oct 2026 04:25:08 +0200
Subject: [PATCH 6/7] include: AROS native EGL types in eglplatform.h

The same EGLNative*Type definitions as AROS's own header, so the native
EGL backend hands windows to egl.library unchanged.
---
 include/EGL/eglplatform.h | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/include/EGL/eglplatform.h b/include/EGL/eglplatform.h
index 101fd74..7ace4b0 100644
--- a/include/EGL/eglplatform.h
+++ b/include/EGL/eglplatform.h
@@ -119,6 +119,15 @@ typedef Display *EGLNativeDisplayType;
 typedef Pixmap   EGLNativePixmapType;
 typedef Window   EGLNativeWindowType;
 
+#elif defined(__AROS__)
+
+/* The same types as AROS's own <EGL/eglplatform.h>: ANGLE's native EGL
+ * backend hands its windows to egl.library unchanged. */
+struct Window;  /* intuition/intuition.h */
+typedef void              *EGLNativeDisplayType;
+typedef void              *EGLNativePixmapType;
+typedef struct Window     *EGLNativeWindowType;
+
 #elif defined(__unix__)
 
 typedef void             *EGLNativeDisplayType;
